    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.30.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
